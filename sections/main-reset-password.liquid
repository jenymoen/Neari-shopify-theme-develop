<section class="auth page-width">
  <div class="auth__panel">
    <h1 class="display-l">{{ 'customer.reset.title' | t }}</h1>
    {%- form 'reset_customer_password', class: 'auth__form' -%}
      {%- if form.errors -%}
        <div class="form-message form-message--error" role="alert">{{ form.errors | default_errors }}</div>
      {%- endif -%}
      <div class="field">
        <label class="field__label" for="ResetPassword">{{ 'customer.fields.password' | t }}</label>
        <input id="ResetPassword" class="input" type="password" name="customer[password]" autocomplete="new-password" required>
      </div>
      <div class="field">
        <label class="field__label" for="ResetPasswordConfirmation">{{ 'customer.fields.password_confirmation' | t }}</label>
        <input id="ResetPasswordConfirmation" class="input" type="password" name="customer[password_confirmation]" autocomplete="new-password" required>
      </div>
      <button type="submit" class="button button--primary">{{ 'customer.reset.submit' | t }}</button>
    {%- endform -%}
  </div>
</section>

{% schema %}
{
  "name": "Nytt passord",
  "settings": []
}
{% endschema %}
