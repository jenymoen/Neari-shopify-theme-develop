<section class="auth auth--wide page-width">
  <header class="account__header">
    <h1 class="display-l">{{ 'customer.account.title' | t }}</h1>
    <a href="{{ routes.account_logout_url }}" class="button button--secondary">{{ 'customer.account.logout' | t }}</a>
  </header>

  <div class="account__grid">
    <div class="account__orders">
      <h2 class="heading">{{ 'customer.account.orders' | t }}</h2>
      {%- paginate customer.orders by 20 -%}
        {%- if customer.orders.size > 0 -%}
          <table class="account__table">
            <thead>
              <tr>
                <th scope="col">{{ 'customer.orders.order' | t }}</th>
                <th scope="col">{{ 'customer.orders.date' | t }}</th>
                <th scope="col">{{ 'customer.orders.payment_status' | t }}</th>
                <th scope="col">{{ 'customer.orders.fulfillment_status' | t }}</th>
                <th scope="col">{{ 'customer.orders.total' | t }}</th>
              </tr>
            </thead>
            <tbody>
              {%- for order in customer.orders -%}
                <tr>
                  <th scope="row"><a href="{{ order.customer_url }}">{{ order.name }}</a></th>
                  <td>{{ order.created_at | time_tag: format: 'date' }}</td>
                  <td>{{ order.financial_status_label }}</td>
                  <td>{{ order.fulfillment_status_label }}</td>
                  <td>{{ order.total_price | money }}</td>
                </tr>
              {%- endfor -%}
            </tbody>
          </table>
        {%- else -%}
          <p class="text-muted">{{ 'customer.orders.none' | t }}</p>
        {%- endif -%}
        {%- if paginate.pages > 1 -%}
          {% render 'pagination', paginate: paginate %}
        {%- endif -%}
      {%- endpaginate -%}
    </div>

    <aside class="account__details card">
      <h2 class="heading">{{ 'customer.account.details' | t }}</h2>
      <p>{{ customer.name | escape }}<br>{{ customer.email | escape }}</p>
      {%- if customer.default_address != blank -%}
        <address>{{ customer.default_address | format_address }}</address>
      {%- endif -%}
      <a href="{{ routes.account_addresses_url }}">{{ 'customer.account.addresses' | t }} ({{ customer.addresses_count }})</a>
    </aside>
  </div>
</section>

{% schema %}
{
  "name": "Konto",
  "settings": []
}
{% endschema %}
