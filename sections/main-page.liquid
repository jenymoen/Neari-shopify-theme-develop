<article class="page-content page-width">
  <h1 class="display-l">{{ page.title | escape }}</h1>
  <div class="rte page-content__body">{{ page.content }}</div>
</article>

{% stylesheet %}
  .page-content {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
    max-width: 840px;
    margin-inline: auto;
    padding-block: var(--space-8) var(--section-gap);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Sideinnhold",
  "settings": []
}
{% endschema %}
