    },
    {
      "type": "text",
      "id": "card_time",
      "label": "Varslingskort: klokkeslett",
      "default": "08:12"
    },
    {
      "type": "text",
      "id": "strip_text",
      "label": "Nederste stripe",
      "default": "Ring tre faste nummer"
    },
    {
      "type": "header",
      "content": "Utenfor Norge"
    },
    {
      "type": "paragraph",
      "content": "Ice Junior finnes ikke i Sverige og Danmark. Fyll ut disse feltene for å vise annen tekst utenfor det norske markedet. La overskriften stå tom for å vise teksten over i alle markeder."
    },
    {
      "type": "text",
      "id": "alt_badge",
      "label": "Merke",
      "default": "Ingen Neari-avgift"
    },
    {
      "type": "text",
      "id": "alt_heading",
      "label": "Overskrift",
      "default": "Én gang betalt. Ingen månedsavgift."
    },
    {
      "type": "textarea",
      "id": "alt_text",
      "label": "Undertekst",
      "default": "Bruk ditt eget SIM. Neari tar ingen månedsavgift."
    },
    {
      "type": "textarea",
      "id": "alt_fine_print",
      "label": "Liten tekst",
      "default": "Fungerer med vanlig nano-SIM fra alle operatører."
    }
  ],
  "presets": [
    {
      "name": "Hero"
    }
  ]
