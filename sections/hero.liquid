{%- liquid
  assign use_alt = false
  if section.settings.alt_heading != blank and localization.country.iso_code != 'NO'
    assign use_alt = true
  endif

  if use_alt
    assign hero_heading = section.settings.alt_heading
    assign hero_text = section.settings.alt_text
    assign hero_badge = section.settings.alt_badge
    assign hero_fine_print = section.settings.alt_fine_print
  else
    assign hero_heading = section.settings.heading
    assign hero_text = section.settings.text
    assign hero_badge = section.settings.badge
    assign hero_fine_print = section.settings.fine_print
  endif

  assign badge_class = 'badge--ice'
  if section.settings.segment == 'eldre'
    assign badge_class = 'badge--care'
  elsif use_alt
    assign badge_class = 'badge--neutral'
  endif
-%}
<section class="hero page-width">
  <div class="hero__content">
    {%- if hero_badge != blank -%}
      <span class="badge {{ badge_class }}">{{ hero_badge | escape }}</span>
    {%- endif -%}
    {%- if hero_heading != blank -%}
      <h1 class="display-xl">{{ hero_heading | escape }}</h1>
    {%- endif -%}
    {%- if hero_text != blank -%}
      <p class="body-l text-muted hero__text">{{ hero_text | escape }}</p>
    {%- endif -%}

    {%- if section.settings.primary_label != blank or section.settings.secondary_label != blank -%}
      <div class="hero__buttons">
        {%- if section.settings.primary_label != blank -%}
          <a href="{{ section.settings.primary_link | default: routes.all_products_collection_url }}" class="button button--primary">{{ section.settings.primary_label | escape }}</a>
        {%- endif -%}
        {%- if section.settings.secondary_label != blank -%}
          <a href="{{ section.settings.secondary_link | default: '#klokker' }}" class="button button--secondary">{{ section.settings.secondary_label | escape }}</a>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if hero_fine_print != blank -%}
      <p class="fine-print hero__fine-print">{{ hero_fine_print | escape }}</p>
    {%- endif -%}
  </div>

  <div class="hero__visual">
    <div class="hero__image media">
      {% render 'image', image: section.settings.image, sizes: '(min-width: 990px) 440px, 90vw', widths: '360, 540, 720, 900', priority: true, placeholder: 'lifestyle-1' %}
    </div>
    <div class="hero__ping" aria-hidden="true"></div>
    {%- if section.settings.card_text != blank -%}
      <div class="hero__card">
        {% render 'icon', name: 'map-pin', size: 22 %}
        <span class="hero__card-title">{{ section.settings.card_text | escape }}</span>
        {%- if section.settings.card_time != blank -%}
          <span class="hero__card-time">{{ section.settings.card_time | escape }}</span>
        {%- endif -%}
      </div>
    {%- endif -%}
    {%- if section.settings.strip_text != blank -%}
      <div class="hero__strip">
        {% render 'icon', name: 'phone', size: 18 %}
        {{ section.settings.strip_text | escape }}
      </div>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .hero {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 440px), 1fr));
    gap: var(--space-12);
    align-items: center;
    padding-top: 40px;
    padding-bottom: var(--section-gap);
  }

  @media (min-width: 990px) {
    .hero {
      padding-top: 56px;
    }
  }

  .hero__content {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .hero__text {
    max-width: 460px;
    text-wrap: pretty;
  }

  .hero__buttons {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
  }

  .hero__fine-print {
    max-width: 420px;
  }

  .hero__visual {
    position: relative;
    width: 100%;
    max-width: 560px;
    aspect-ratio: 1 / 1;
    justify-self: center;
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    grid-template-rows: repeat(6, 1fr);
    gap: var(--space-4);
  }

  .hero__image {
    grid-column: 1 / 5;
    grid-row: 1 / 6;
    border-radius: var(--radius-l);
    background: var(--color-sky);
  }

  .hero__ping {
    grid-column: 5 / 7;
    grid-row: 1 / 3;
    border-radius: var(--radius-pill);
    background: var(--color-coral);
  }

  .hero__card {
    grid-column: 5 / 7;
    grid-row: 3 / 7;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: 6px;
    padding: 18px;
    border-radius: var(--radius-m);
    background: var(--color-fjord);
    color: var(--color-sand);
  }

  .hero__card .icon {
    color: var(--color-coral);
    width: 22px;
    height: 22px;
  }

  .hero__card-title {
    font: 600 14px/18px var(--font-sans);
  }

  .hero__card-time {
    font: 400 12px/16px var(--font-sans);
    color: var(--color-dark-muted);
  }

  .hero__strip {
    grid-column: 1 / 5;
    grid-row: 6 / 7;
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 0 20px;
    border-radius: var(--radius-pill);
    background: var(--color-sage);
    color: var(--color-fjord);
    font: 600 14px/18px var(--font-sans);
  }

  @media (max-width: 749px) {
    .hero__card {
      padding: var(--space-3);
    }

    .hero__strip {
      padding: 0 var(--space-3);
      font-size: 12px;
      line-height: 16px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Hero",
  "settings": [
    {
      "type": "select",
      "id": "segment",
      "label": "Segment (styrer fargen på merket)",
      "options": [
        { "value": "barn", "label": "Barn (sky)" },
        { "value": "eldre", "label": "Eldre (sage)" }
      ],
      "default": "barn"
    },
    {
      "type": "header",
      "content": "Tekst"
    },
    {
      "type": "text",
      "id": "badge",
      "label": "Merke",
      "default": "0 kr/mnd med Ice Junior"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Overskrift",
      "default": "Én gang betalt. 0 kr i måneden."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Undertekst",
      "default": "Neari fungerer med Ice Junior – gratis mobilabonnement for barn under 13 år."
    },
    {
      "type": "textarea",
      "id": "fine_print",
      "label": "Liten tekst",
      "default": "Ice Junior leveres av Ice. Gjelder barn under 13 år, kun i Norge og i Ices nett. Sjekk dekning på ice.no."
    },
    {
      "type": "header",
      "content": "Knapper"
    },
    {
      "type": "text",
      "id": "primary_label",
      "label": "Primærknapp",
      "default": "Kjøp nå"
    },
    {
      "type": "url",
      "id": "primary_link",
      "label": "Lenke for primærknapp"
    },
    {
      "type": "text",
      "id": "secondary_label",
      "label": "Sekundærknapp",
      "default": "Se klokkene"
    },
    {
      "type": "url",
      "id": "secondary_link",
      "label": "Lenke for sekundærknapp",
      "info": "Tom lenke scroller til seksjonen med ankeret #klokker."
    },
    {
      "type": "header",
      "content": "Bilde og kort"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Livsstilsbilde",
      "info": "Barn på sykkel til skolen, klokka synlig. Anbefalt stående format."
    },
    {
      "type": "text",
      "id": "card_text",
      "label": "Varslingskort: tekst",
