<section class="auth page-width">
  <div class="auth__panel">
    <h1 class="display-l">{{ 'customer.register.title' | t }}</h1>

    {%- form 'create_customer', novalidate: 'novalidate', class: 'auth__form' -%}
      {%- if form.errors -%}
        <div class="form-message form-message--error" role="alert">{{ form.errors | default_errors }}</div>
      {%- endif -%}
      <div class="field">
        <label class="field__label" for="RegisterFirstName">{{ 'customer.fields.first_name' | t }}</label>
        <input id="RegisterFirstName" class="input" type="text" name="customer[first_name]" value="{{ form.first_name | escape }}" autocomplete="given-name">
      </div>
      <div class="field">
        <label class="field__label" for="RegisterLastName">{{ 'customer.fields.last_name' | t }}</label>
        <input id="RegisterLastName" class="input" type="text" name="customer[last_name]" value="{{ form.last_name | escape }}" autocomplete="family-name">
      </div>
      <div class="field">
        <label class="field__label" for="RegisterEmail">{{ 'customer.fields.email' | t }}</label>
        <input id="RegisterEmail" class="input" type="email" name="customer[email]" value="{{ form.email | escape }}" autocomplete="email" required>
      </div>
      <div class="field">
        <label class="field__label" for="RegisterPassword">{{ 'customer.fields.password' | t }}</label>
        <input id="RegisterPassword" class="input" type="password" name="customer[password]" autocomplete="new-password" required>
      </div>
      <button type="submit" class="button button--primary">{{ 'customer.register.submit' | t }}</button>
      <a href="{{ routes.account_login_url }}">{{ 'customer.register.have_account' | t }}</a>
    {%- endform -%}
  </div>
</section>

{% schema %}
{
  "name": "Opprett konto",
  "settings": []
}
{% endschema %}
