<section class="auth auth--wide page-width">
  <header class="account__header">
    <h1 class="display-l">{{ 'customer.addresses.title' | t }}</h1>
    <a href="{{ routes.account_url }}" class="button button--secondary">{{ 'customer.orders.back' | t }}</a>
  </header>

  <details class="card account__details">
    <summary class="button button--primary">{{ 'customer.addresses.add' | t }}</summary>
    {%- form 'customer_address', customer.new_address, class: 'auth__form' -%}
      {% render 'address-fields', form: form, id: 'new' %}
      <button type="submit" class="button button--primary">{{ 'customer.addresses.save' | t }}</button>
    {%- endform -%}
  </details>

  {%- paginate customer.addresses by 10 -%}
    <ul class="account__grid" role="list">
      {%- for address in customer.addresses -%}
        <li class="card account__details">
          {%- if address == customer.default_address -%}
            <span class="badge badge--ice">{{ 'customer.addresses.default' | t }}</span>
          {%- endif -%}
          <address>{{ address | format_address }}</address>
          <details>
            <summary class="button button--secondary">{{ 'customer.addresses.edit' | t }}</summary>
            {%- form 'customer_address', address, class: 'auth__form' -%}
              {% render 'address-fields', form: form, id: address.id %}
              <button type="submit" class="button button--primary">{{ 'customer.addresses.save' | t }}</button>
            {%- endform -%}
          </details>
          <form method="post" action="{{ address.url }}">
            <input type="hidden" name="_method" value="delete">
            <button type="submit" class="button button--secondary">{{ 'customer.addresses.delete' | t }}</button>
          </form>
        </li>
      {%- else -%}
        <li class="text-muted">{{ 'customer.addresses.none' | t }}</li>
      {%- endfor -%}
    </ul>
    {%- if paginate.pages > 1 -%}
      {% render 'pagination', paginate: paginate %}
    {%- endif -%}
  {%- endpaginate -%}
</section>

{% schema %}
{
  "name": "Adresser",
  "settings": []
}
{% endschema %}
