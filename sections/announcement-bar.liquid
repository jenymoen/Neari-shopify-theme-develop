{%- if section.settings.text != blank -%}
  <div class="announcement-bar">
    {%- if section.settings.link != blank -%}
      <a href="{{ section.settings.link }}" class="announcement-bar__text">{{ section.settings.text | escape }}</a>
    {%- else -%}
      <p class="announcement-bar__text">{{ section.settings.text | escape }}</p>
    {%- endif -%}
  </div>
{%- endif -%}

{% stylesheet %}
  .announcement-bar {
    background: var(--color-fjord);
    padding: 10px var(--space-4);
    text-align: center;
  }

  .announcement-bar__text {
    margin: 0;
    color: var(--color-sand);
    font: 600 13px/16px var(--font-sans);
  }

  a.announcement-bar__text:hover {
    color: var(--color-sand);
    text-decoration: underline;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Kunngjøringsbar",
  "enabled_on": { "groups": ["header"] },
  "settings": [
    {
      "type": "text",
      "id": "text",
      "label": "Tekst",
      "default": "Én gang betalt. 0 kr i måneden med Ice Junior."
    },
    {
      "type": "url",
      "id": "link",
      "label": "Lenke (valgfri)"
    }
  ]
}
{% endschema %}
