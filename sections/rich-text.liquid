<section class="rich-text page-width rich-text--{{ section.settings.align }}">
  {%- for block in section.blocks -%}
    {%- case block.type -%}
      {%- when 'heading' -%}
        <h2 class="display-l" {{ block.shopify_attributes }}>{{ block.settings.heading | escape }}</h2>
      {%- when 'text' -%}
        <div class="rte body-l text-muted" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>
      {%- when 'button' -%}
        {%- if block.settings.label != blank -%}
          <a href="{{ block.settings.link | default: routes.all_products_collection_url }}" class="button button--primary" {{ block.shopify_attributes }}>{{ block.settings.label | escape }}</a>
        {%- endif -%}
    {%- endcase -%}
  {%- endfor -%}
</section>

{% stylesheet %}
  .rich-text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-6);
    max-width: 840px;
    padding-bottom: var(--section-gap);
  }

  .rich-text--center {
    align-items: center;
    text-align: center;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Tekst",
  "settings": [
    {
      "type": "select",
      "id": "align",
      "label": "Plassering",
      "options": [
        { "value": "left", "label": "Venstre" },
        { "value": "center", "label": "Midten" }
      ],
      "default": "left"
    }
  ],
  "blocks": [
    {
      "type": "heading",
      "name": "Overskrift",
      "settings": [
        { "type": "text", "id": "heading", "label": "Overskrift", "default": "Overskrift" }
      ]
    },
    {
      "type": "text",
      "name": "Tekst",
      "settings": [
        { "type": "richtext", "id": "text", "label": "Tekst", "default": "<p>Fortell om Neari med varme, rolige og konkrete ord.</p>" }
      ]
    },
    {
      "type": "button",
      "name": "Knapp",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "label", "label": "Knapptekst", "default": "Se klokkene" },
        { "type": "url", "id": "link", "label": "Lenke" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Tekst",
      "blocks": [
        { "type": "heading" },
        { "type": "text" }
      ]
    }
  ]
}
{% endschema %}
